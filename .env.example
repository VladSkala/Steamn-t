# Django
DJANGO_SECRET_KEY=replace-with-a-local-development-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=steamnt
POSTGRES_USER=steamnt
POSTGRES_PASSWORD=replace-with-a-local-development-password
# Host-run Django uses loopback; Docker Compose overrides this to the db service.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55433
# Keep development connections non-persistent; production can opt in behind a pooler.
POSTGRES_CONN_MAX_AGE=0
POSTGRES_SSLMODE=prefer
POSTGRES_CHANNEL_BINDING=prefer

# Docker Compose host ports
BACKEND_PORT=8010
FRONTEND_PORT=5180

# Password recovery (console locally; configure SMTP for delivered email)
FRONTEND_URL=http://localhost:5180
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@steamnt.local
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_USE_TLS=True

# Separate resources from older Steamn’t installations
COMPOSE_PROJECT_NAME=steamnt-purple-final

# Production object storage (Neon S3-compatible storage)
USE_S3_STORAGE=False
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-central-1
NEON_PUBLIC_BUCKET=steamnt-media
NEON_PRIVATE_BUCKET=steamnt-private

# Optional production CSRF origins, comma-separated (for custom domains/admin)
DJANGO_CSRF_TRUSTED_ORIGINS=
