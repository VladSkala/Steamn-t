# The frontend uses /api by default. Vite proxies it to Django in development.
# Set this only when the API is hosted on a separate browser-visible origin.
# VITE_API_URL=https://api.example.com/api

# Docker Compose supplies http://backend:8000. The local fallback is
# http://127.0.0.1:8000, so this normally does not need to be set manually.
# VITE_PROXY_TARGET=http://127.0.0.1:8000
